@@ -0,0 +1,92 @@
+package search
+
+import (
+	"encoding/json"
+	"os"
+	"testing"
+
+	"EquinoxChess/internal/board"
+	"EquinoxChess/internal/tt"
+	"EquinoxChess/internal/uci"
+)
+
+type lossPosition struct {
+	Fen, Opening string
+	Prefix       []string
+	GameDepth    int `json:"game_depth"`
+	Best         struct{ Move string }
+}
+type resultAtDepth struct {
+	Move           string
+	Depth, Score   int
+	Nodes          uint64
+	ReferenceVisit *rootVisit `json:",omitempty"`
+}
+type analyzedLoss struct {
+	Round int
+	Color string
+	Point *lossPosition `json:"turning_point"`
+}
+type replayRow struct {
+	Round                                 int
+	Color                                 string
+	Baseline, Deeper, FullRoot, HashFirst resultAtDepth
+}
+
+func TestLossReplay(t *testing.T) {
+	src, err := os.ReadFile(os.Getenv("LOSS_INPUT"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var input struct{ Losses []analyzedLoss }
+	if err := json.Unmarshal(src, &input); err != nil {
+		t.Fatal(err)
+	}
+	var results []replayRow
+	for _, loss := range input.Losses {
+		p := loss.Point
+		if p == nil {
+			continue
+		}
+		b, err := board.FromFEN(p.Opening)
+		if err != nil {
+			t.Fatal(err)
+		}
+		for _, text := range p.Prefix {
+			m, err := uci.ParseUCIMove(b, text)
+			if err != nil {
+				t.Fatal(err)
+			}
+			b.MakeMove(m)
+		}
+		check, err := board.FromFEN(p.Fen)
+		if err != nil || check.Pieces != b.Pieces || check.SideToMove != b.SideToMove ||
+			check.CastlingRights != b.CastlingRights || check.HalfmoveClock != b.HalfmoveClock ||
+			(check.EnPassant != board.NoSquare && check.EnPassant != b.EnPassant) {
+			t.Fatal("position history mismatch", loss.Round, loss.Color)
+		}
+		probeMove, err = uci.ParseUCIMove(b, p.Best.Move)
+		if err != nil || p.GameDepth < 1 {
+			t.Fatal("invalid reference or depth", loss.Round, loss.Color)
+		}
+		d := min(p.GameDepth, 8)
+		run := func(depth int, full, hashFirst bool) resultAtDepth {
+			probeDepth, probeFullRoot, probeHashFirst = depth, full, hashFirst
+			pos := *b
+			s := Search{TT: tt.NewTT(1 << 20)}
+			m, score, completed, n := s.SearchRoot(&pos, depth)
+			if completed != depth {
+				t.Fatal("incomplete replay")
+			}
+			return resultAtDepth{uci.MoveToUCI(m), completed, score, n, probeVisit}
+		}
+		results = append(results, replayRow{loss.Round, loss.Color, run(d, false, false), run(d+1, false, false), run(d, true, false), run(d, false, true)})
+	}
+	output, err := json.MarshalIndent(results, "", "  ")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = os.WriteFile(os.Getenv("LOSS_OUTPUT"), append(output, '\n'), 0644); err != nil {
+		t.Fatal(err)
+	}
+}
