diff --git a/internal/search/diagnosis.go b/internal/search/diagnosis.go
new file mode 100644
index 0000000..18a780e
--- /dev/null
+++ b/internal/search/diagnosis.go
@@ -0,0 +1,138 @@
+package search
+
+import (
+	"crypto/sha256"
+	"encoding/binary"
+	"fmt"
+	"hash"
+	"io"
+	"strings"
+
+	"EquinoxChess/internal/board"
+	"EquinoxChess/internal/move"
+	"EquinoxChess/internal/uci"
+)
+
+// Offline, single-search probe. A shadow search uses a separate report and state.
+type searchDiagnosis struct {
+	out                                                                      io.Writer
+	puzzle                                                                   bool
+	mainDigest                                                               hash.Hash
+	main, quiet, frontiers                                                   uint64
+	promotions, firstPromotions, promotedNodes, capturesBelow, evasionsBelow uint64
+	byMove                                                                   map[string]uint64
+	longestQ, qStart, activePromotions, iteration                            int
+	path                                                                     [MaxDepth]uint32
+	largest                                                                  uint64
+	largestPath                                                              string
+	largestStart                                                             int
+}
+
+var report *searchDiagnosis
+
+func newDiagnosis(out io.Writer, puzzle bool) *searchDiagnosis {
+	return &searchDiagnosis{out: out, puzzle: puzzle, mainDigest: sha256.New(), byMove: make(map[string]uint64)}
+}
+
+func diagMove(m uint32) string {
+	if m == 0 {
+		return "null"
+	}
+	return uci.MoveToUCI(m)
+}
+
+func (r *searchDiagnosis) line(n int) string {
+	a := make([]string, n)
+	for i := range a {
+		a[i] = diagMove(r.path[i])
+	}
+	return strings.Join(a, " ")
+}
+
+func (r *searchDiagnosis) log(values ...any) { fmt.Fprintln(r.out, values...) }
+
+func (r *searchDiagnosis) mainNode(b *board.Board, ply, depth, alpha, beta int) {
+	r.main++
+	var buf [48]byte
+	for i, value := range [...]uint64{b.ZobristKey, uint64(b.HalfmoveClock), uint64(ply), uint64(depth), uint64(alpha), uint64(beta)} {
+		binary.LittleEndian.PutUint64(buf[i*8:], value)
+	}
+	r.mainDigest.Write(buf[:])
+}
+
+func (r *searchDiagnosis) enterQuietMove(m uint32, added, inCheck bool) {
+	if added {
+		r.activePromotions++
+		r.promotions++
+	}
+	if r.activePromotions > 0 {
+		if move.IsCapture(m) {
+			r.capturesBelow++
+		}
+		if inCheck {
+			r.evasionsBelow++
+		}
+	}
+}
+
+func (r *searchDiagnosis) leaveQuietMove(m uint32, added, first bool, ply, score int, nodes uint64) {
+	if added {
+		r.activePromotions--
+	}
+	if first {
+		r.firstPromotions++
+		r.promotedNodes += nodes
+		r.byMove[diagMove(m)] += nodes
+		if nodes > r.largest {
+			r.largest = nodes
+			r.largestPath = r.line(ply + 1)
+			r.largestStart = r.qStart
+		}
+	}
+	if r.puzzle && r.iteration == 1 && diagMove(r.path[0]) == "g5g6" {
+		r.log("q-move", r.line(ply+1), "score", score)
+	}
+}
+
+func (r *searchDiagnosis) order(s *Search, remaining []uint32, index int) {
+	if !r.puzzle || s.Ply != 0 || index < 4 || index > 5 {
+		return
+	}
+	for _, m := range remaining {
+		u := diagMove(m)
+		if u == "h5h6" || u == "f5f6" || u == "g5g6" {
+			r.log("order", r.iteration, index, u, scoreMove(s, m))
+		}
+	}
+}
+
+func isPuzzlePush(m uint32) bool {
+	u := diagMove(m)
+	return u == "h5h6" || u == "f5f6"
+}
+
+func (r *searchDiagnosis) tableProbe(s *Search, b *board.Board, depth, alpha, beta int, cutoff bool) {
+	if !r.puzzle || s.Ply != 1 || !isPuzzlePush(r.path[0]) || !cutoff {
+		return
+	}
+	e := s.TT.Entries[b.ZobristKey&s.TT.Mask]
+	r.log("tt-cut", r.iteration, diagMove(r.path[0]), depth, alpha, beta, "stored", e.Depth, e.Score, traceTTFlag(e.Flag), diagMove(e.Move))
+}
+
+func (r *searchDiagnosis) fullDepthProbe(s *Search, b *board.Board, ply int, m uint32, depth int) {
+	if !r.puzzle || ply != 0 || !isPuzzlePush(m) {
+		return
+	}
+	shadow := cloneTraceSearch(s, nil)
+	position := *b
+	report = newDiagnosis(io.Discard, false)
+	defer func() { report = r }()
+	score := -shadow.Negamax(&position, depth-1, -Infinity, Infinity)
+	r.log("full-window-copy", depth, diagMove(m), depth-1, score, shadow.Nodes)
+}
+
+func (r *searchDiagnosis) rootMove(m uint32, depth, index int, mode string, childDepth, alpha, score int, nodes uint64) {
+	if r.puzzle {
+		r.log("root-move", depth, index, diagMove(m), mode, childDepth, alpha, score, nodes)
+	}
+}
diff --git a/internal/search/diagnosis_test.go b/internal/search/diagnosis_test.go
new file mode 100644
index 0000000..632cd07
--- /dev/null
+++ b/internal/search/diagnosis_test.go
@@ -0,0 +1,41 @@
+package search
+
+import (
+	"fmt"
+	"os"
+	"testing"
+
+	"EquinoxChess/internal/board"
+	"EquinoxChess/internal/tt"
+)
+
+func TestQuietPromotionDiagnosis(t *testing.T) {
+	cases := []struct {
+		name, fen string
+		entries   int
+		puzzle    bool
+	}{
+		{"Game17_W_ply17", "rn1q1rk1/pb2bppp/1p2pn2/2ppN3/3P4/2NBP3/PPPB1PPP/R2Q1RK1 w - - 2 9", 1 << 16, false},
+		{"0JLoe", "8/P3kpp1/8/4KPPP/8/5b2/8/8 w - - 1 55", 1 << 20, true},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			b, err := board.FromFEN(c.fen)
+			if err != nil {
+				t.Fatal(err)
+			}
+			report = newDiagnosis(os.Stdout, c.puzzle)
+			s := Search{TT: tt.NewTT(c.entries)}
+			m, score, d, n := s.SearchRoot(b, 6)
+			r := report
+			r.log("result", diagMove(m), score, d, n)
+			if r.main+r.quiet != n || r.activePromotions != 0 {
+				t.Fatal("unbalanced counters")
+			}
+			r.log("main", r.main, "quiet", r.quiet, "frontiers", r.frontiers, "main-sha256", fmt.Sprintf("%x", r.mainDigest.Sum(nil)))
+			r.log("promotions", r.promotions, "first", r.firstPromotions, "subtree", r.promotedNodes, "captures", r.capturesBelow, "evasions", r.evasionsBelow)
+			r.log("first-promotion-subtree-by-move", r.byMove)
+			r.log("max-quiet-plies", r.longestQ, "largest-first-subtree", r.largest, "frontier-at-ply", r.largestStart, "line", r.largestPath)
+		})
+	}
+}
